#!/usr/bin/env bash

# Security review acknowledgement:
# HANCORE-linux reviewed the file handling and called out validate-by-path then
# reopen-by-path races in credential/profile state writes.
# GitHub: https://github.com/HANCORE-linux

# shellcheck disable=SC2034
# This file is sourced by openvpn-ctl. These path/uid variables are library
# outputs, so ShellCheck sees some of them as unused when checking this file by
# itself even though openvpn-ctl consumes them after sourcing.
openvpn_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-openvpn"
openvpn_runtime_dir="/run/simpleopenvpn-$(id -u)"
openvpn_auth_dir="$openvpn_state_dir/auth"
openvpn_config_file="$openvpn_state_dir/config"
openvpn_config_dir_file="$openvpn_state_dir/config-dir"
openvpn_profiles_file="$openvpn_state_dir/profiles"
openvpn_username_file="$openvpn_state_dir/username"
openvpn_auth_file="$openvpn_runtime_dir/auth-user-pass"
openvpn_pid_file="$openvpn_runtime_dir/openvpn.pid"
openvpn_status_file="$openvpn_runtime_dir/openvpn.status"
openvpn_log_file="$openvpn_runtime_dir/openvpn.log"
openvpn_uid="$(id -u)"
openvpn_gid="$(id -g)"

# Security model for unprivileged state:
#
# Files below openvpn_state_dir are owned by the desktop user and may contain
# sensitive profile metadata or saved VPN credentials. They are not trusted by
# the privileged launcher until that launcher reopens and validates them with
# O_NOFOLLOW and fstat().
#
# The helpers in this file still need race-safe writes because a compromised
# same-user process can replace paths inside ~/.local/state while this plugin is
# saving credentials or profile selections. HANCORE-linux specifically called
# out validate-by-path then reopen-by-path patterns. The Python helpers below
# therefore keep source and destination descriptors open and operate relative to
# verified directory fds.

openvpn_fail() {
  printf 'SimpleOpenVPN: %s\n' "$*" >&2
  return 1
}

openvpn_validate_dir() {
  local dir="$1" mode owner
  [[ -d "$dir" ]] || openvpn_fail "not a directory: $dir" || return 1
  [[ ! -L "$dir" ]] || openvpn_fail "refusing symlink directory: $dir" || return 1
  owner=$(stat -c '%u' -- "$dir" 2>/dev/null) || return 1
  [[ "$owner" == "$openvpn_uid" ]] || openvpn_fail "directory not owned by current user: $dir" || return 1
  mode=$(stat -c '%a' -- "$dir" 2>/dev/null) || return 1
  [[ "$mode" == "700" ]] || openvpn_fail "directory must be mode 700: $dir" || return 1
}

openvpn_prepare_dir() {
  local dir="$1"
  if [[ -e "$dir" && ( ! -d "$dir" || -L "$dir" ) ]]; then
    openvpn_fail "refusing unsafe path: $dir" || return 1
  fi
  umask 077
  mkdir -p -- "$dir"
  chmod 700 -- "$dir"
  openvpn_validate_dir "$dir"
}

openvpn_validate_file() {
  local file="$1" owner
  [[ -e "$file" ]] || return 0
  [[ -f "$file" && ! -L "$file" ]] || openvpn_fail "refusing unsafe file: $file" || return 1
  owner=$(stat -c '%u' -- "$file" 2>/dev/null) || return 1
  [[ "$owner" == "$openvpn_uid" ]] || openvpn_fail "file not owned by current user: $file" || return 1
}

openvpn_atomic_publish() {
  local file="$1" dir base
  dir=$(dirname -- "$file")
  base=$(basename -- "$file")

  command -v python3 >/dev/null 2>&1 || openvpn_fail "python3 is required for secure file writes" || return 1
  # Descriptor-relative publish:
  #
  # Open the destination directory with O_DIRECTORY/O_NOFOLLOW, validate the
  # opened directory with fstat(), then create and rename the temp file relative
  # to that same dir_fd. This closes the race where an attacker replaces the
  # directory path after validation but before open/rename.
  python3 -c '
import os
import secrets
import stat
import sys

directory, basename, uid_text = sys.argv[1:]
uid = int(uid_text)
if basename != os.path.basename(basename) or basename in ("", ".", ".."):
    raise SystemExit("SimpleOpenVPN: invalid target filename")

dir_flags = os.O_RDONLY
if hasattr(os, "O_DIRECTORY"):
    dir_flags |= os.O_DIRECTORY
if hasattr(os, "O_NOFOLLOW"):
    dir_flags |= os.O_NOFOLLOW

flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW

tmp = None
fd = None
dir_fd = None
try:
    dir_fd = os.open(directory, dir_flags)
    dir_stat = os.fstat(dir_fd)
    if not stat.S_ISDIR(dir_stat.st_mode):
        raise NotADirectoryError(directory)
    if dir_stat.st_uid != uid:
        raise PermissionError(f"directory not owned by current user: {directory}")
    if stat.S_IMODE(dir_stat.st_mode) != 0o700:
        raise PermissionError(f"directory must be mode 700: {directory}")

    # Create and publish inside dir_fd, never by resolving directory again.
    for _ in range(100):
        candidate = f".{basename}.tmp.{secrets.token_hex(8)}"
        try:
            fd = os.open(candidate, flags, 0o600, dir_fd=dir_fd)
            tmp = candidate
            break
        except FileExistsError:
            continue
    if fd is None:
        raise FileExistsError("could not create a unique temporary file")

    with os.fdopen(fd, "wb", closefd=True) as handle:
        fd = None
        while True:
            chunk = os.read(0, 65536)
            if not chunk:
                break
            handle.write(chunk)
        handle.flush()
        os.fsync(handle.fileno())

    os.replace(tmp, basename, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    os.fsync(dir_fd)
    tmp = None
except Exception as exc:
    print(f"SimpleOpenVPN: secure write failed: {exc}", file=sys.stderr)
    raise SystemExit(1)
finally:
    if fd is not None:
        os.close(fd)
    if tmp is not None and dir_fd is not None:
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except FileNotFoundError:
            pass
    if dir_fd is not None:
        os.close(dir_fd)
' "$dir" "$base" "$openvpn_uid"
}

openvpn_secure_truncate() {
  local file="$1"
  printf '' | openvpn_atomic_publish "$file"
}

openvpn_secure_write_auth() {
  local file="$1" username="$2" password="$3"
  # Auth files are always written through openvpn_atomic_publish so they land as
  # mode 0600 in a user-owned mode 0700 directory. They are copied into /run by
  # the privileged launcher only after the selected profile is validated.
  {
    printf '%s\n' "$username"
    printf '%s\n' "$password"
  } | openvpn_atomic_publish "$file"
}

openvpn_secure_write_line() {
  local file="$1" value="$2"
  printf '%s\n' "$value" | openvpn_atomic_publish "$file"
}

openvpn_secure_copy_file() {
  local src="$1" dest="$2"
  local dir base
  dir=$(dirname -- "$dest")
  base=$(basename -- "$dest")

  command -v python3 >/dev/null 2>&1 || openvpn_fail "python3 is required for secure file writes" || return 1
  # Secure copy invariant:
  #
  # Hold both the source file descriptor and destination directory descriptor
  # after validation. Copying from/to those descriptors avoids source reopens and
  # destination directory replacement races. This mirrors the openat/renameat
  # style behavior requested by HANCORE-linux.
  python3 -c '
import os
import secrets
import stat
import sys

source, directory, basename, uid_text = sys.argv[1:]
uid = int(uid_text)
if basename != os.path.basename(basename) or basename in ("", ".", ".."):
    raise SystemExit("SimpleOpenVPN: invalid target filename")

read_flags = os.O_RDONLY
dir_flags = os.O_RDONLY
if hasattr(os, "O_DIRECTORY"):
    dir_flags |= os.O_DIRECTORY
if hasattr(os, "O_NOFOLLOW"):
    read_flags |= os.O_NOFOLLOW
    dir_flags |= os.O_NOFOLLOW

write_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
if hasattr(os, "O_NOFOLLOW"):
    write_flags |= os.O_NOFOLLOW

src_fd = None
dir_fd = None
tmp_fd = None
tmp = None
try:
    src_fd = os.open(source, read_flags)
    src_stat = os.fstat(src_fd)
    if not stat.S_ISREG(src_stat.st_mode):
        raise OSError(f"not a regular file: {source}")
    if src_stat.st_uid != uid:
        raise PermissionError(f"file not owned by current user: {source}")

    dir_fd = os.open(directory, dir_flags)
    dir_stat = os.fstat(dir_fd)
    if not stat.S_ISDIR(dir_stat.st_mode):
        raise NotADirectoryError(directory)
    if dir_stat.st_uid != uid:
        raise PermissionError(f"directory not owned by current user: {directory}")
    if stat.S_IMODE(dir_stat.st_mode) != 0o700:
        raise PermissionError(f"directory must be mode 700: {directory}")

    # Create the replacement file relative to the verified destination dir_fd.
    for _ in range(100):
        candidate = f".{basename}.tmp.{secrets.token_hex(8)}"
        try:
            tmp_fd = os.open(candidate, write_flags, 0o600, dir_fd=dir_fd)
            tmp = candidate
            break
        except FileExistsError:
            continue
    if tmp_fd is None:
        raise FileExistsError("could not create a unique temporary file")

    while True:
        chunk = os.read(src_fd, 65536)
        if not chunk:
            break
        view = memoryview(chunk)
        while view:
            written = os.write(tmp_fd, view)
            view = view[written:]
    os.fchmod(tmp_fd, 0o600)
    os.fsync(tmp_fd)
    os.close(tmp_fd)
    tmp_fd = None

    os.replace(tmp, basename, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    os.fsync(dir_fd)
    tmp = None
except Exception as exc:
    print(f"SimpleOpenVPN: secure copy failed: {exc}", file=sys.stderr)
    raise SystemExit(1)
finally:
    if tmp_fd is not None:
        os.close(tmp_fd)
    if tmp is not None and dir_fd is not None:
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except FileNotFoundError:
            pass
    if dir_fd is not None:
        os.close(dir_fd)
    if src_fd is not None:
        os.close(src_fd)
' "$src" "$dir" "$base" "$openvpn_uid"
}

openvpn_init_state() {
  openvpn_prepare_dir "$openvpn_state_dir"
  openvpn_prepare_dir "$openvpn_auth_dir"
}

openvpn_profile_hash() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    target=$(openvpn_selected_config 2>/dev/null || true)
  fi
  [[ -n "$target" ]] || return 1
  printf '%s' "$target" | md5sum | awk '{ print $1 }'
}

openvpn_profile_auth_file() {
  local target="${1:-}"
  local h
  h=$(openvpn_profile_hash "$target" 2>/dev/null) || return 1
  printf '%s/%s.auth\n' "$openvpn_auth_dir" "$h"
}

openvpn_profile_username() {
  local target="${1:-}"
  local auth_f
  auth_f=$(openvpn_profile_auth_file "$target" 2>/dev/null) || return 1
  [[ -r "$auth_f" ]] || return 1
  sed -n '1p' "$auth_f"
}

openvpn_profile_has_auth() {
  local target="${1:-}"
  local auth_f
  auth_f=$(openvpn_profile_auth_file "$target" 2>/dev/null) || return 1
  [[ -s "$auth_f" ]]
}

openvpn_sync_runtime_auth() {
  return 1
}

openvpn_selected_config() {
  [[ -r "$openvpn_config_file" ]] || return 1
  sed -n '1p' "$openvpn_config_file"
}

openvpn_selected_dir() {
  if [[ -r "$openvpn_config_dir_file" ]]; then
    sed -n '1p' "$openvpn_config_dir_file"
  fi
}

openvpn_remember_profile() {
  local target="$1"
  [[ -n "$target" && -r "$target" ]] || return 1
  {
    [[ -r "$openvpn_profiles_file" ]] && sed '/^[[:space:]]*$/d' "$openvpn_profiles_file"
    printf '%s\n' "$target"
  } | awk '!seen[$0]++' | openvpn_atomic_publish "$openvpn_profiles_file"
}

openvpn_known_profiles() {
  [[ -r "$openvpn_profiles_file" ]] || return 0
  while IFS= read -r profile; do
    [[ -n "$profile" && -r "$profile" ]] && printf '%s\n' "$profile"
  done < "$openvpn_profiles_file"
}

openvpn_username() {
  local u
  u=$(openvpn_profile_username 2>/dev/null || true)
  if [[ -n "$u" ]]; then
    printf '%s\n' "$u"
    return 0
  fi
  [[ -r "$openvpn_username_file" ]] || return 1
  sed -n '1p' "$openvpn_username_file"
}

openvpn_has_auth() {
  openvpn_profile_has_auth
}

openvpn_pid() {
  [[ -r "$openvpn_pid_file" ]] || return 1
  sed -n '1p' "$openvpn_pid_file"
}

openvpn_pid_is_openvpn() {
  local pid="$1" comm
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -d "/proc/$pid" ]] || return 1
  comm=$(ps -p "$pid" -o comm= 2>/dev/null | awk '{ print $1 }')
  [[ "$comm" == "openvpn" ]]
}

openvpn_matching_pids() {
  ps -eo pid=,comm=,args= 2>/dev/null | awk -v pid_file="$openvpn_pid_file" '
    $2 == "openvpn" && index($0, "--writepid " pid_file) { print $1 }
  '
}

openvpn_is_running() {
  [[ -n "$(openvpn_matching_pids)" ]]
}

openvpn_tun_iface() {
  ip -o link show 2>/dev/null | awk -F': ' '$2 ~ /^(tun|tap)[0-9]+$/ { print $2; exit }'
}

openvpn_bytes_text() {
  local iface="$1" rx tx
  [[ -n "$iface" ]] || return 1
  rx=$(cat "/sys/class/net/$iface/statistics/rx_bytes" 2>/dev/null) || return 1
  tx=$(cat "/sys/class/net/$iface/statistics/tx_bytes" 2>/dev/null) || return 1
  awk -v rx="$rx" -v tx="$tx" '
    function human(bytes) {
      split("B KiB MiB GiB TiB", units, " ")
      value = bytes + 0
      unit_index = 1
      while (value >= 1024 && unit_index < 5) {
        value = value / 1024
        unit_index++
      }
      if (unit_index == 1) return sprintf("%d%s", value, units[unit_index])
      return sprintf("%.1f%s", value, units[unit_index])
    }
    BEGIN { printf "rx %s tx %s", human(rx), human(tx) }
  '
}

openvpn_status_summary() {
  [[ -r "$openvpn_status_file" ]] || return 1
  awk -F, '
    $1 == "TITLE" { title = $2 }
    $1 == "TIME" { updated = $2 }
    $1 == "SUCCESS" { success = $2 }
    END {
      if (success != "") print success
      else if (updated != "") print "updated " updated
      else if (title != "") print title
    }
  ' "$openvpn_status_file"
}
