#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/openvpn-lib"
openvpn_init_state

cmd=${1:-status}
shift || true

case "$cmd" in
status)
  config=$(openvpn_selected_config 2>/dev/null || true)
  config_name=""
  [[ -n "$config" ]] && config_name=$(basename "$config")
  config_dir=$(openvpn_selected_dir 2>/dev/null || true)
  [[ -z "$config_dir" && -n "$config" ]] && config_dir=$(dirname "$config")
  [[ -z "$config_dir" ]] && config_dir="$HOME"

  configs_json="[]"
  auth_configs_json="[]"
	  mapfile -t saved_profiles < <(openvpn_known_profiles)
	  if [[ -d "$config_dir" ]]; then
	    mapfile -t conf_list < <(
	      {
	        printf '%s\n' "${saved_profiles[@]}"
	        find "$config_dir" -maxdepth 2 -type f \( -name '*.ovpn' -o -name '*.conf' \) 2>/dev/null
	      } | grep -E '\.(ovpn|conf)$' | sort -u
	    )
	  else
	    conf_list=("${saved_profiles[@]}")
	  fi
	  if ((${#conf_list[@]} > 0)); then
	    configs_json=$(printf '%s\n' "${conf_list[@]}" | jq -R . | jq -s .)

	    auth_list=()
	    for c in "${conf_list[@]}"; do
	      if openvpn_profile_has_auth "$c"; then
	        auth_list+=("$c")
	      fi
	    done
	    if ((${#auth_list[@]} > 0)); then
	      auth_configs_json=$(printf '%s\n' "${auth_list[@]}" | jq -R . | jq -s .)
	    fi
	  fi

  is_running=false
  if openvpn_is_running; then
    is_running=true
  fi

  iface=$(openvpn_tun_iface || true)
  ip_addr=""
  [[ -n "$iface" ]] && ip_addr=$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{ print $4; exit }' || true)

  bytes=""
  [[ -n "$iface" ]] && bytes=$(openvpn_bytes_text "$iface" 2>/dev/null || true)

  # Check credentials for active profile
  has_auth=false
  if openvpn_has_auth; then
    has_auth=true
  fi

  uname=$(openvpn_username 2>/dev/null || true)

  summary=$(openvpn_status_summary 2>/dev/null || true)

  log_tail=""
  if [[ -r "$openvpn_log_file" ]]; then
    log_tail=$(tail -n 12 "$openvpn_log_file" 2>/dev/null || true)
  fi

  jq -n \
    --argjson connected "$is_running" \
    --arg iface "${iface:-}" \
    --arg ip "${ip_addr:-}" \
    --arg config "${config:-}" \
    --arg config_name "${config_name:-}" \
    --arg config_dir "${config_dir:-}" \
    --argjson configs "$configs_json" \
    --argjson auth_configs "$auth_configs_json" \
    --argjson has_auth "$has_auth" \
    --arg username "${uname:-}" \
    --arg bytes_text "${bytes:-}" \
    --arg status_summary "${summary:-}" \
    --arg log_tail "${log_tail:-}" \
    '{
      connected: $connected,
      iface: $iface,
      ip: $ip,
      config: $config,
      config_name: $config_name,
      config_dir: $config_dir,
      configs: $configs,
      auth_configs: $auth_configs,
      has_auth: $has_auth,
      username: $username,
      bytes_text: $bytes_text,
      status_summary: $status_summary,
      log_tail: $log_tail
    }'
  ;;

connect)
  config=$(openvpn_selected_config 2>/dev/null || true)
  if [[ -z "$config" || ! -r "$config" ]]; then
    echo "No valid config selected" >&2
    exit 1
  fi
  if openvpn_is_running; then
    echo "Already running"
    exit 0
  fi

  config_dir=$(dirname "$config")
  auth_f=$(openvpn_profile_auth_file "$config" 2>/dev/null || true)

  # OpenVPN needs privilege for tunnel setup. The privileged helper owns the
  # runtime directory and uses descriptor-relative file operations so unprivileged
  # users cannot redirect log/status/pid/auth paths with symlink swaps.
  pkexec python3 - "$openvpn_uid" "$openvpn_gid" "$config" "$config_dir" "$auth_f" "$openvpn_runtime_dir" <<'PY'
import os
import stat
import subprocess
import sys

uid = int(sys.argv[1])
gid = int(sys.argv[2])
config_path = sys.argv[3]
config_dir = sys.argv[4]
auth_source = sys.argv[5]
runtime_dir = sys.argv[6]

auth_path = os.path.join(runtime_dir, "auth-user-pass")
pid_path = os.path.join(runtime_dir, "openvpn.pid")
status_path = os.path.join(runtime_dir, "openvpn.status")
log_path = os.path.join(runtime_dir, "openvpn.log")
auth_name = os.path.basename(auth_path)
pid_name = os.path.basename(pid_path)
status_name = os.path.basename(status_path)
log_name = os.path.basename(log_path)

def fail(message):
    print(f"SimpleOpenVPN: {message}", file=sys.stderr)
    raise SystemExit(1)

def ensure_runtime_dir():
    # Keep runtime files outside user-writable state. The directory is
    # root-owned and executable-only for others, while readable outputs are
    # created as mode 0600 for the requesting user.
    parent = os.path.dirname(runtime_dir)
    parent_stat = os.stat(parent)
    if parent_stat.st_uid != 0 or parent_stat.st_mode & 0o022:
        fail(f"unsafe runtime parent: {parent}")

    try:
        st = os.lstat(runtime_dir)
    except FileNotFoundError:
        os.mkdir(runtime_dir, 0o711)
        st = os.lstat(runtime_dir)

    if not stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode):
        fail(f"unsafe runtime path: {runtime_dir}")
    if st.st_uid != 0:
        fail(f"runtime directory is not root-owned: {runtime_dir}")
    if stat.S_IMODE(st.st_mode) != 0o711:
        os.chmod(runtime_dir, 0o711)

    dir_flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        dir_flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        dir_flags |= os.O_NOFOLLOW
    runtime_fd = os.open(runtime_dir, dir_flags)
    runtime_stat = os.fstat(runtime_fd)
    if not stat.S_ISDIR(runtime_stat.st_mode) or runtime_stat.st_uid != 0 or stat.S_IMODE(runtime_stat.st_mode) != 0o711:
        os.close(runtime_fd)
        fail(f"unsafe runtime directory: {runtime_dir}")
    return runtime_fd

def open_user_file(path, required):
    # User-supplied config/auth paths are opened once with O_NOFOLLOW and then
    # passed forward by descriptor. The privileged process does not reopen them.
    if not path:
        if required:
            fail("missing required file path")
        return None
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags)
    except FileNotFoundError:
        if required:
            fail(f"file not found: {path}")
        return None
    except OSError as exc:
        if required:
            fail(f"cannot open file safely: {path}: {exc}")
        return None

    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        os.close(fd)
        fail(f"not a regular file: {path}")
    if st.st_uid != uid:
        os.close(fd)
        fail(f"file is not owned by requesting user: {path}")
    return fd

def secure_replace(dir_fd, name, data, mode, owner_uid, owner_gid):
    # Publish runtime files under the verified root-owned runtime dir_fd. This
    # prevents the privileged process from following user-controlled paths.
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW

    tmp = None
    fd = None
    for attempt in range(100):
        candidate = f".{name}.tmp.{os.getpid()}.{attempt}"
        try:
            fd = os.open(candidate, flags, mode, dir_fd=dir_fd)
            tmp = candidate
            break
        except FileExistsError:
            continue
    if fd is None:
        fail(f"could not create temporary file for {name}")

    try:
        view = memoryview(data)
        while view:
            written = os.write(fd, view)
            view = view[written:]
        os.fchown(fd, owner_uid, owner_gid)
        os.fchmod(fd, mode)
        os.fsync(fd)
        os.close(fd)
        fd = None
        os.replace(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        os.fsync(dir_fd)
        tmp = None
    finally:
        if fd is not None:
            os.close(fd)
        if tmp is not None:
            try:
                os.unlink(tmp, dir_fd=dir_fd)
            except FileNotFoundError:
                pass

def read_fd(fd):
    chunks = []
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        chunks.append(chunk)
    return b"".join(chunks)

runtime_fd = ensure_runtime_dir()
config_fd = open_user_file(config_path, True)
auth_fd = open_user_file(auth_source, False)

secure_replace(runtime_fd, log_name, b"", 0o600, uid, gid)
secure_replace(runtime_fd, status_name, b"", 0o600, uid, gid)
secure_replace(runtime_fd, pid_name, b"", 0o600, uid, gid)

args = [
    "openvpn",
    "--config", f"/proc/self/fd/{config_fd}",
    "--script-security", "1",
    "--writepid", pid_path,
    "--status", status_path, "5",
]

if auth_fd is not None:
    secure_replace(runtime_fd, auth_name, read_fd(auth_fd), 0o600, 0, 0)
    os.close(auth_fd)
    # Keep credentials out of argv and ask OpenVPN not to cache them in memory.
    args.extend(["--auth-user-pass", auth_path, "--auth-nocache"])
else:
    try:
        os.unlink(auth_name, dir_fd=runtime_fd)
    except FileNotFoundError:
        pass

log_flags = os.O_WRONLY | os.O_APPEND
if hasattr(os, "O_NOFOLLOW"):
    log_flags |= os.O_NOFOLLOW
log_fd = os.open(log_name, log_flags, dir_fd=runtime_fd)
log_st = os.fstat(log_fd)
if not stat.S_ISREG(log_st.st_mode) or log_st.st_uid != uid or stat.S_IMODE(log_st.st_mode) != 0o600:
    os.close(log_fd)
    fail(f"unsafe log file: {log_path}")
try:
    subprocess.Popen(
        args,
        cwd=config_dir,
        pass_fds=(config_fd,),
        stdout=log_fd,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
finally:
    os.close(log_fd)
    os.close(config_fd)
    os.close(runtime_fd)
PY
  echo "connected"
  ;;

disconnect)
  if ! openvpn_is_running; then
    echo "Not running"
    exit 0
  fi
  pids=$(openvpn_matching_pids)
  if [[ -z "$pids" ]]; then
    pids=$(openvpn_pid 2>/dev/null || true)
  fi
  if [[ -n "$pids" ]]; then
    pkexec /bin/sh -c 'auth_file=$1; shift; for pid in "$@"; do kill "$pid" 2>/dev/null || true; done; rm -f -- "$auth_file"' openvpn-widget "$openvpn_auth_file" $pids
  fi
  echo "disconnected"
  ;;

toggle)
  if openvpn_is_running; then
    "$0" disconnect
  else
    "$0" connect
  fi
  ;;

set_config)
  new_conf=${1:?Usage: set_config <path>}
  if [[ ! -r "$new_conf" ]]; then
    echo "File unreadable: $new_conf" >&2
    exit 1
  fi
	  openvpn_secure_write_line "$openvpn_config_file" "$new_conf"
	  openvpn_secure_write_line "$openvpn_config_dir_file" "$(dirname "$new_conf")"
	  openvpn_remember_profile "$new_conf"
	  echo "ok"
	  ;;

set_config_dir)
  new_dir=${1:?Usage: set_config_dir <path>}
  new_dir="${new_dir/#\~/$HOME}"
  if [[ ! -d "$new_dir" ]]; then
    echo "Directory not found: $new_dir" >&2
    exit 1
  fi
  openvpn_secure_write_line "$openvpn_config_dir_file" "$new_dir"
  echo "ok"
  ;;

	pick_file|add_profile)
	  file=""
	  if command -v zenity &>/dev/null; then
	    file=$(zenity --file-selection --title="Add OpenVPN Profile" --file-filter="OpenVPN Config (*.ovpn *.conf) | *.ovpn *.conf" 2>/dev/null || true)
	  elif command -v omarchy-file-select &>/dev/null; then
	    file=$(omarchy-file-select --title "Add OpenVPN Profile" --extensions "ovpn conf" 2>/dev/null || true)
	  fi

	  if [[ -n "$file" && -r "$file" ]]; then
	    openvpn_secure_write_line "$openvpn_config_file" "$file"
	    openvpn_secure_write_line "$openvpn_config_dir_file" "$(dirname "$file")"
	    openvpn_remember_profile "$file"
	    echo "$file"
  else
    echo "cancelled"
  fi
  ;;

open_folder)
  dir=$(openvpn_selected_dir 2>/dev/null || true)
  [[ -z "$dir" ]] && dir="$HOME"
  if command -v nautilus &>/dev/null; then
    nautilus "$dir" &>/dev/null &
  elif command -v xdg-open &>/dev/null; then
    xdg-open "$dir" &>/dev/null &
  fi
  echo "ok"
  ;;

set_credentials)
  IFS= read -r uname || {
    echo "Usage: set_credentials < username/password/profile on stdin >" >&2
    exit 1
  }
  IFS= read -r passwd || passwd=""
  IFS= read -r target_conf || target_conf=""
  if [[ -z "$target_conf" ]]; then
    target_conf=$(openvpn_selected_config 2>/dev/null || true)
  fi

  # Save profile-specific auth file
  if [[ -n "$target_conf" ]]; then
    auth_f=$(openvpn_profile_auth_file "$target_conf" 2>/dev/null || true)
    if [[ -n "$auth_f" ]]; then
      openvpn_secure_write_auth "$auth_f" "$uname" "$passwd"
    fi
  fi

  # Save fallback/global username
  openvpn_secure_write_line "$openvpn_username_file" "$uname"

  echo "ok"
  ;;

clear_credentials)
  target_conf=${1:-}
  if [[ -z "$target_conf" ]]; then
    target_conf=$(openvpn_selected_config 2>/dev/null || true)
  fi

  if [[ -n "$target_conf" ]]; then
    auth_f=$(openvpn_profile_auth_file "$target_conf" 2>/dev/null || true)
    [[ -n "$auth_f" ]] && rm -f "$auth_f"
  fi
  pkexec /bin/rm -f -- "$openvpn_auth_file" 2>/dev/null || true
  echo "ok"
  ;;

*)
  echo "Unknown command: $cmd" >&2
  exit 1
  ;;
esac
